# ============================================================
# Raw data & curated dataset outputs (large / third-party)
# ============================================================
data/*
!data/README.md

datasets/*.npy
datasets/*.fasta
datasets/*.csv
datasets/*.xlsx
!datasets/.gitkeep

# Temporary files from CD-HIT & curation steps
temp_curation/
*.clstr
*_for_cdhit.fasta
*_after_cdhit2d.fasta

# ============================================================
# 3D structures
# ============================================================
*.pdb
*.cif
*.mmcif
structures/

