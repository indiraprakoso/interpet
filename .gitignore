# ============================================================
*.npy
*.npz
*.pt
*.pth
*.ckpt
*.bin
*.safetensors
*.pkl
*.joblib
*.h5

# Whitelist: final curated dataset + embeddings (needed for reproducibility)
!datasets/train_final.fasta
!datasets/train_final_labels.csv
!datasets/benchmark_final.fasta
!datasets/benchmark_final_labels.csv
!datasets/X_train_embeddings.npy
!datasets/X_benchmark_embeddings.npy

# Trained model outputs per ablation notebook
models/
checkpoints/
results/*.xlsx
results/*.csv
!results/.gitkeep

# Cache for HuggingFace / Transformers / torch_geometric (if downloaded locally)
.cache/
**/transformers_cache/
**/torch_geometric_cache/

